# ==============================================================================
# STARTUP RESEARCH SYSTEM — MULTI-PROVIDER API KEYS (WITH AUTO-FALLBACK)
# ==============================================================================
# You need at least ONE valid API key to run the autonomous agents locally.
# If you provide multiple keys, the system automatically uses them as fallbacks
# (e.g. if Gemini hits rate limits, it auto-switches to Groq or Claude seamlessly!).

# 1. Google Gemini (Recommended for fast validation)
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# 2. Groq (High-speed Llama 3.3 70B & Mixtral)
# Get key: https://console.groq.com/keys
GROQ_API_KEY=""

# 3. Anthropic Claude (Claude 3.5 Sonnet / Extended Thinking)
# Get key: https://console.anthropic.com/
ANTHROPIC_API_KEY=""

# 4. OpenAI (GPT-4o / GPT-4o-mini)
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# 5. OpenRouter (Access to 100+ open-source models)
# Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=""
